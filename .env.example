# --- Base de datos ---
# Local (sin Docker): sqlite:///./carnetruck.db
# Con Docker compose usa postgresql+psycopg://carnetruck:carnetruck@db:5432/carnetruck
DATABASE_URL=postgresql+psycopg://carnetruck:carnetruck@localhost:5432/carnetruck

# --- Seguridad ---
JWT_SECRET=cambia-este-secreto-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Comportamiento ---
# sync: evalúa alertas inline en el request. celery: las encola en Redis (worker + beat).
ALERT_EVAL_MODE=sync
ALERT_COOLDOWN_SECONDS=600
MISSING_SIGNAL_THRESHOLD_MINUTES=60
AUTO_CREATE_TABLES=true
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Notificaciones (n8n u otro webhook) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# --- MQTT (opcional, para ingesta directa desde broker) ---
MQTT_URL=
MQTT_TOPIC=carnetruck/+/readings

# --- PDF ---
# auto | weasyprint | simple (fallback puro de Python sin dependencias)
PDF_ENGINE=auto
